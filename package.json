{
  "name": "arc-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Arc Media Server app for LG webOS and Samsung Tizen TVs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:browser": "vite build --mode browser",
    "build:webos": "vite build --mode webos",
    "build:tizen": "vite build --mode tizen",
    "package:webos": "npm run build:webos && node scripts/package-webos.mjs",
    "package:tizen": "npm run build:tizen && node scripts/package-tizen.mjs",
    "check": "tsc -b && npm run build:webos && npm run build:tizen && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@enact/core": "^5.6.0",
    "@enact/spotlight": "^5.6.0",
    "core-js": "^3.51.0",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webos-tools/cli": "^3.2.6",
    "acorn": "^8.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
